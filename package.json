{
  "name": "crm",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "extension"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:status": "prisma migrate status",
    "db:backfill:orgs-members": "npx --yes tsx scripts/backfill-orgs-members-to-postgres.ts",
    "db:reconcile:orgs-members": "npx --yes tsx scripts/reconcile-orgs-members.ts",
    "db:backfill:crm": "npx --yes tsx scripts/backfill-crm-to-postgres.ts",
    "db:backfill:crm-profiles": "npx --yes tsx scripts/backfill-crm-profiles.ts",
    "db:reconcile:crm": "npx --yes tsx scripts/reconcile-crm-entities.ts",
    "db:export:pg-documents": "npx --yes tsx scripts/export-pg-documents-archive.ts",
    "db:import:script-library": "npx --yes tsx scripts/import-script-library-archive.ts",
    "test": "vitest run",
    "build:worker": "node scripts/build-worker.mjs",
    "worker": "tsx src/worker/index.ts",
    "worker:built": "node dist/worker/index.mjs",
    "check:firebase-imports": "node scripts/check-firebase-imports.mjs",
    "export:strategy-packs": "npx --yes tsx scripts/export-strategy-packs.ts",
    "export:knowledge-pack": "npx --yes tsx scripts/export-knowledge-pack.ts",
    "export:prompts-pack": "npx --yes tsx scripts/export-prompts-pack.ts",
    "extension:dev": "npm run dev -w @nova/intent-radar-extension",
    "extension:build": "npm run build -w @nova/intent-radar-extension",
    "extension:typecheck": "npm run typecheck -w @nova/intent-radar-extension"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.78",
    "@ai-sdk/google": "^3.0.78",
    "@ai-sdk/openai": "^3.0.64",
    "@base-ui/react": "^1.4.1",
    "@clerk/nextjs": "^7.7.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@nova/scoring": "file:packages/nova-scoring",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "^5.100.7",
    "@tanstack/react-query-devtools": "^5.100.7",
    "@tanstack/react-table": "^8.21.3",
    "@types/papaparse": "^5.5.2",
    "ai": "^6.0.188",
    "bullmq": "^6.0.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "geist": "^1.7.0",
    "gsap": "^3.15.0",
    "imapflow": "^1.3.3",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.14.0",
    "mailparser": "^3.9.8",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "papaparse": "^5.5.3",
    "pg": "^8.23.0",
    "postprocessing": "^6.39.4",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.74.0",
    "recharts": "^3.8.1",
    "redis": "^6.2.0",
    "rss-parser": "^3.13.0",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.1",
    "@emnapi/runtime": "1.11.1",
    "@tailwindcss/postcss": "^4",
    "@types/ioredis": "^4.28.10",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "uuid": "^11.1.1",
    "@emnapi/core": "1.11.1",
    "@emnapi/runtime": "1.11.1"
  }
}
