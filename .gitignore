# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Firebase Functions build output
functions/lib/
functions/node_modules/

# Browser extension (local install deps; dist is built separately)
extension/node_modules/

# production
/build
/extension/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log*
firestore-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma Client (generated via postinstall / db:generate)
/src/generated/prisma

# Graphify (local-only — rebuild with npm run graphify:build)
/graphify-out/
/.graphifyignore
/.gitattributes
/.claude/settings.json
/.cursor/rules/graphify.mdc

# P6.3 Firestore export archives (may contain tenant PII — never commit)
/archives/

# Private strategy packs (tenant-specific ICP — do not ship in SaaS product)
/packs/private/*.json
/packs/private/seeds/

# Exported org knowledge / prompts packs (may contain private corpus text)
/archives/knowledge/
.shots/

/src/generated/prisma
