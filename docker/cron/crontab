# POST /api/cron/queue/dispatch with JSON body (requires CRON_SECRET + web running)
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

*/5 * * * * /usr/local/bin/cron-dispatch.sh imap-sync >/dev/null 2>&1
2-59/5 * * * * /usr/local/bin/cron-dispatch.sh scheduled-email >/dev/null 2>&1
7-59/15 * * * * /usr/local/bin/cron-dispatch.sh scrapers >/dev/null 2>&1
0 * * * * /usr/local/bin/cron-dispatch.sh content-reminders >/dev/null 2>&1
* * * * * /usr/local/bin/cron-dispatch.sh dashboard-summary >/dev/null 2>&1
