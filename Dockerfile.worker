# Dockerfile.worker — Nova CRM worker tier
# Consumes the job queue: email sync, imports, scrapers, AI/RAG jobs, scheduled sends.
# Deliberately a SEPARATE image/deployable from the web tier (Dockerfile) so a slow
# IMAP provider, a big import job, or an AI job can NEVER block interactive user traffic.

FROM node:22-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat

# ---------- Dependencies ----------
FROM base AS deps
COPY package.json package-lock.json ./
COPY packages/nova-scoring/package.json packages/nova-scoring/package.json
RUN npm ci --omit=dev

# ---------- Build (if the worker is TypeScript, compile it) ----------
FROM base AS builder
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build:worker
# ^ add a `build:worker` script (e.g. `tsc -p tsconfig.worker.json`) that compiles
#   src/worker/** to dist/worker/**. Adjust the path below if yours differs.

# ---------- Runtime ----------
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs \
 && adduser  --system --uid 1001 worker

COPY --from=deps    /app/node_modules ./node_modules
COPY --from=builder /app/dist/worker  ./dist/worker
COPY --from=builder /app/package.json ./package.json

USER worker

# No exposed HTTP port needed unless you add a small /healthz endpoint for the
# orchestrator — recommended, since Cloud Run/Fargate/Fly all want a healthcheck.
CMD ["node", "dist/worker/index.js"]
