# Dockerfile.worker — Nova CRM worker tier
# Consumes the job queue: email sync, imports, scrapers, AI/RAG jobs, scheduled sends.
# Deliberately a SEPARATE image/deployable from the web tier (Dockerfile) so a slow
# IMAP provider, a big import job, or an AI job can NEVER block interactive user traffic.

FROM node:22-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat

# ---------- Dependencies (build) ----------
FROM base AS deps
COPY package.json package-lock.json ./
COPY packages/nova-scoring/package.json packages/nova-scoring/package.json
COPY extension/package.json extension/package.json
RUN npm ci --ignore-scripts

# ---------- Dependencies (runtime — production only) ----------
FROM base AS prod-deps
COPY package.json package-lock.json ./
COPY packages/nova-scoring/package.json packages/nova-scoring/package.json
COPY extension/package.json extension/package.json
RUN npm ci --omit=dev --ignore-scripts

# ---------- Build ----------
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NODE_ENV=production
RUN npx prisma generate
RUN npm run build:worker

# ---------- Runtime ----------
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs \
 && adduser  --system --uid 1001 worker

COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=builder /app/dist/worker  ./dist/worker
COPY --from=builder /app/package.json ./package.json

USER worker

EXPOSE 8081
ENV WORKER_HEALTH_PORT=8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8081/healthz || exit 1

# ESM bundle (Prisma 7 requires real import.meta.url — see scripts/build-worker.mjs)
CMD ["node", "dist/worker/index.mjs"]
