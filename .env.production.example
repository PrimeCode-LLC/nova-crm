# Production environment for docker-compose.prod.yml
# Copy to .env.production, fill in real values, then: chmod 600 .env.production
# Never commit .env.production — it is gitignored.
#
# Deploy:
#   docker compose -f docker-compose.prod.yml --env-file .env.production run --rm migrate
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# --- Public URLs (host only for Caddy; full origin for the app) ---
SITE_DOMAIN=app.yourdomain.com
NEXT_PUBLIC_SITE_URL=https://app.yourdomain.com
SITE_URL=https://app.yourdomain.com
NEXT_PUBLIC_SITE_NAME=Nova CRM

# --- Clerk (required) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Optional: Clerk webhook user sync
# CLERK_WEBHOOK_SECRET=whsec_...

# --- Postgres (Compose service hostnames — not localhost) ---
POSTGRES_USER=nova
POSTGRES_PASSWORD=generate-a-strong-postgres-superuser-password
POSTGRES_DB=nova_crm
NOVA_APP_PASSWORD=generate-a-strong-app-role-password
# Must match the password in DATABASE_URL. Applied by: docker compose ... run --rm migrate
DATABASE_URL=postgres://nova_app:generate-a-strong-app-role-password@postgres:5432/nova_crm
MIGRATE_DATABASE_URL=postgres://nova:generate-a-strong-postgres-superuser-password@postgres:5432/nova_crm
# Prisma pg pool size (default 10). Prod under mailbox-utilization fan-out
# needs headroom — use ~20–25 on the web service (Postgres max_connections=100).
PG_POOL_MAX=25

# --- Redis (set by compose for web/worker; listed here for reference) ---
# REDIS_URL=redis://redis:6379

# --- Cron / background jobs ---
CRON_SECRET=generate-a-long-random-string
QUEUE_WORKER_V1=true
QUEUE_IMPORT_CHUNKS_V1=true
QUEUE_HEAVY_JOBS_V1=true

# --- Platform operators (comma-separated emails) ---
PLATFORM_ADMIN_EMAILS=you@yourcompany.com

# --- Encrypt mailbox / AI / integration secrets at rest (32 random bytes, base64) ---
EMAIL_SECRETS_KEY_BASE64=
AI_SECRETS_KEY_BASE64=

# --- System email (pick one: Resend or SMTP) ---
RESEND_API_KEY=re_...
RESEND_FROM="Nova CRM <noreply@yourdomain.com>"
# SYSTEM_SMTP_HOST=smtp.example.com
# SYSTEM_SMTP_PORT=587
# SYSTEM_SMTP_SECURE=false
# SYSTEM_SMTP_USER=
# SYSTEM_SMTP_PASS=
# SYSTEM_SMTP_FROM="Nova CRM <noreply@yourdomain.com>"

# --- Email open/click tracking ---
MAIL_TRACKING_BASE_URL=https://t.yourdomain.com
# Optional: falls back to EMAIL_SECRETS_KEY_BASE64
# MAIL_TRACKING_SECRET=

# --- Google Calendar + Gmail OAuth (redirect URIs must match SITE_URL) ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Optional mail-only overrides:
# GOOGLE_MAIL_CLIENT_ID=
# GOOGLE_MAIL_CLIENT_SECRET=
# NEXT_PUBLIC_GOOGLE_CALENDAR_CLIENT_ID=

# --- Microsoft Outlook / 365 (optional) ---
# MICROSOFT_CALENDAR_CLIENT_ID=
# MICROSOFT_CALENDAR_CLIENT_SECRET=

# --- Chrome extension allowlist (production store IDs) ---
# NOVA_EXTENSION_IDS=
# NOVA_EXTENSION_DEV_IDS=

# --- Webhooks (optional) ---
# INBOUND_WEBHOOK_SECRET=
# INSTANTLY_WEBHOOK_SECRET=

# --- Postgres feature flags (must match Docker build args; defaults shown) ---
NEXT_PUBLIC_AUTH_CLERK_V1=true
NEXT_PUBLIC_POSTGRES_READ_CRM_V1=true
NEXT_PUBLIC_POSTGRES_READ_LEADS_V1=true
NEXT_PUBLIC_POSTGRES_SOLE_WRITER_CRM_V1=true
NEXT_PUBLIC_POSTGRES_DASHBOARD_SUMMARY_READ_V1=true
