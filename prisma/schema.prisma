// Nova CRM — Prisma schema (Phase 2+)
// P2.1 empty init · P2.2 orgs/members · P2.6–P2.9 accounts/contacts/leads/deals
// P3.1 org_dashboard_summaries
// See Architecture fixes plan/NOVA-CRM-MIGRATION-BABY-STEPS.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Tenant root. Firestore id preserved as primary key for dual-write (P2.3+).
model Organization {
  id                   String    @id
  name                 String
  slug                 String    @unique
  status               String
  planId               String    @map("plan_id")
  maxUsers             Int?      @map("max_users")
  seatsUsed            Int       @default(0) @map("seats_used")
  ownerUid             String?   @map("owner_uid")
  primaryEmail         String?   @map("primary_email")
  pendingOwnerEmail    String?   @map("pending_owner_email")
  trialEndsAt          DateTime? @map("trial_ends_at") @db.Timestamptz(3)
  settings             Json      @default("{}")
  channelAdmin         Json?     @map("channel_admin")
  intakeFilterDefaults Json?     @map("intake_filter_defaults")
  intakePoolEpoch      Int       @default(1) @map("intake_pool_epoch")
  intentPlaybook       Json?     @map("intent_playbook")
  openJoinTokenHash    String?   @map("open_join_token_hash")
  createdAt            DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @map("updated_at") @db.Timestamptz(3)

  members           Member[]
  dashboardSummary  OrgDashboardSummary?

  @@map("organizations")
}

/// Org membership. Firestore: organizations/{orgId}/members/{uid}.
model Member {
  uid            String
  organizationId String    @map("organization_id")
  email          String
  displayName    String    @map("display_name")
  role           String
  status         String
  invitedByUid   String    @map("invited_by_uid")
  joinedAt       DateTime  @map("joined_at") @db.Timestamptz(3)
  disabledAt     DateTime? @map("disabled_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, uid])
  @@index([organizationId])
  @@index([email])
  @@map("members")
}

/// Firestore `accounts/{id}`. Relation FKs deferred until data is clean (ETL-friendly).
model Account {
  id             String   @id
  organizationId String   @map("organization_id")
  name           String
  domain         String?
  industry       String?
  website        String?
  ownerId        String   @map("owner_id")
  contactCount   Int      @default(0) @map("contact_count")
  leadCount      Int      @default(0) @map("lead_count")
  openDealValue  Float    @default(0) @map("open_deal_value")
  /// Full Firestore document (minus id) for dual-write parity.
  payload        Json     @default("{}")
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId])
  @@index([organizationId, ownerId])
  @@map("accounts")
}

/// Firestore `contacts/{id}`.
model Contact {
  id             String   @id
  organizationId String   @map("organization_id")
  accountId      String   @map("account_id")
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  fullName       String   @map("full_name")
  email          String?
  phone          String?
  title          String?
  /// Optional IANA timezone for recipient-local send windows (e.g. `America/New_York`).
  timezone       String?
  ownerId        String   @map("owner_id")
  payload        Json     @default("{}")
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId])
  @@index([organizationId, accountId])
  @@index([organizationId, email])
  @@map("contacts")
}

/// Firestore `leads/{id}`.
model Lead {
  id             String    @id
  organizationId String    @map("organization_id")
  accountId      String    @map("account_id")
  contactId      String    @map("contact_id")
  channel        String
  stage          String
  temperature    String
  priority       String
  ownerId        String    @map("owner_id")
  contactName    String    @map("contact_name")
  companyName    String    @map("company_name")
  intakeKind     String?   @map("intake_kind")
  touches        Int       @default(0)
  isIdle         Boolean   @default(false) @map("is_idle")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  payload        Json      @default("{}")
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([organizationId, ownerId])
  @@index([organizationId, accountId])
  @@map("leads")
}

/// Firestore `deals/{id}`.
model Deal {
  id                String    @id
  organizationId    String    @map("organization_id")
  leadId            String    @map("lead_id")
  accountId         String    @map("account_id")
  contactId         String    @map("contact_id")
  name              String
  stage             String
  value             Float
  currency          String
  probability       Int
  expectedCloseDate DateTime  @map("expected_close_date") @db.Timestamptz(3)
  ownerId           String    @map("owner_id")
  wonAt             DateTime? @map("won_at") @db.Timestamptz(3)
  lostAt            DateTime? @map("lost_at") @db.Timestamptz(3)
  payload           Json      @default("{}")
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([organizationId, leadId])
  @@map("deals")
}

/// Precomputed org dashboard KPIs (P3.1). Mirrors Firestore `orgDashboardSummaries/{orgId}`
/// / `OrgDashboardSummary` (P0.3). Writers land in P3.2; read cutover in P3.3.
model OrgDashboardSummary {
  organizationId            String   @id @map("organization_id")
  version                   Int      @default(1)
  updatedAt                 DateTime @map("updated_at") @db.Timestamptz(3)
  openSalesLeads            Int      @default(0) @map("open_sales_leads")
  idleSalesLeads            Int      @default(0) @map("idle_sales_leads")
  prospects                 Int      @default(0)
  prospectsNeedRouting      Int      @default(0) @map("prospects_need_routing")
  prospectsReadyToPush      Int      @default(0) @map("prospects_ready_to_push")
  prospectsPushed           Int      @default(0) @map("prospects_pushed")
  followupsDue              Int      @default(0) @map("followups_due")
  overdueFollowups          Int      @default(0) @map("overdue_followups")
  totalReplies              Int      @default(0) @map("total_replies")
  repliesPendingReview      Int      @default(0) @map("replies_pending_review")
  openPipelineValue         Float    @default(0) @map("open_pipeline_value")
  openDealCount             Int      @default(0) @map("open_deal_count")
  leadEstimateContributors  Int      @default(0) @map("lead_estimate_contributors")
  /// Sales-lead counts by pipeline stage (`PipelineStage` → count).
  pipelineByStage           Json     @default("{}") @map("pipeline_by_stage")
  /// Per-channel `{ count, won }` (`ChannelKey` → object).
  channelMix                Json     @default("{}") @map("channel_mix")
  /// Per-channel funnel stage counts.
  funnelByChannel           Json     @default("{}") @map("funnel_by_channel")
  /// Windows: today / 7d / 30d / all → range metrics object.
  ranges                    Json     @default("{}")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("org_dashboard_summaries")
}

/// Generic document store (P7) — replaces Firestore flat collections + org subcollections.
model PgDocument {
  path           String   @id
  organizationId String?  @map("organization_id")
  collectionRoot String   @map("collection_root")
  payload        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId, collectionRoot])
  @@index([collectionRoot])
  @@map("pg_documents")
}

/// Organization invite tokens (P7).
model OrgInvite {
  id             String    @id
  organizationId String    @map("organization_id")
  email          String
  role           String
  tokenHash      String    @map("token_hash")
  status         String    @default("pending")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdByUid   String    @map("created_by_uid")
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  acceptedByUid  String?   @map("accepted_by_uid")

  @@index([organizationId])
  @@index([tokenHash])
  @@map("org_invites")
}

/// Relational outbound scheduled-email queue (replaces nested scheduledEmails docs).
model ScheduledEmailRow {
  id                String    @id
  organizationId    String    @map("organization_id")
  mailboxOwnerUid   String    @map("mailbox_owner_uid")
  mailboxId         String    @map("mailbox_id")
  scheduledByUserId String?   @map("scheduled_by_user_id")
  followupId        String?   @map("followup_id")
  leadId            String?   @map("lead_id")
  /// pending | processing | sent | failed | cancelled
  status            String
  scheduledAt       DateTime  @map("scheduled_at") @db.Timestamptz(3)
  notBeforeAt       DateTime? @map("not_before_at") @db.Timestamptz(3)
  attempts          Int       @default(0)
  failureKind       String?   @map("failure_kind")
  leaseUntil        DateTime? @map("lease_until") @db.Timestamptz(3)
  leaseId           String?   @map("lease_id")
  idempotencyKey    String    @map("idempotency_key")
  toEmail           String    @map("to_email")
  fromEmail         String    @map("from_email")
  subject           String
  messageId         String?   @map("message_id")
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(3)
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelReason      String?   @map("cancel_reason")
  error             String?
  lastSkipReason    String?   @map("last_skip_reason")
  /// body/html/text/cc/bcc/replyTo/displayName/attachments/inReplyTo/referenceIds/forceNewThread
  payload           Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId])
  @@index([organizationId, mailboxOwnerUid, status])
  @@index([organizationId, mailboxId, status, scheduledAt])
  @@map("scheduled_emails")
}

/// Per-mailbox send pacing (nextAvailableAt reserved at claim time).
model MailboxSendState {
  organizationId  String    @map("organization_id")
  mailboxOwnerUid String    @map("mailbox_owner_uid")
  mailboxId       String    @map("mailbox_id")
  nextAvailableAt DateTime  @map("next_available_at") @db.Timestamptz(3)
  lastSentAt      DateTime? @map("last_sent_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@id([organizationId, mailboxOwnerUid, mailboxId])
  @@map("mailbox_send_state")
}

/// Org-wide email suppression list (unsubscribe / hard bounce / complaint / manual).
model EmailSuppression {
  id              String   @id
  organizationId  String   @map("organization_id")
  emailNormalized String   @map("email_normalized")
  /// unsubscribe | hard_bounce | complaint | manual
  reason          String
  source          String   @default("system")
  leadId          String?  @map("lead_id")
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organizationId, emailNormalized])
  @@index([organizationId])
  @@map("email_suppressions")
}

/// Append-only email lifecycle events (deliverability + conversion analytics).
model EmailEvent {
  id               String   @id
  organizationId   String   @map("organization_id")
  occurredAt       DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// scheduled | sent | failed | cancelled | bounced | opened | clicked | replied | unsubscribed
  type             String
  scheduledEmailId String?  @map("scheduled_email_id")
  followupId       String?  @map("followup_id")
  leadId           String?  @map("lead_id")
  mailboxId        String?  @map("mailbox_id")
  messageId        String?  @map("message_id")
  recipient        String?
  meta             Json     @default("{}")

  @@index([organizationId, type, occurredAt])
  @@index([organizationId, scheduledEmailId])
  @@index([organizationId, leadId])
  @@map("email_events")
}

/// Immutable outreach variant bundle (prompt + model + cadence recipe).
model OutreachConfig {
  id                   String   @id
  organizationId       String   @map("organization_id")
  featureKey           String   @map("feature_key")
  label                String
  systemPrompt         String   @map("system_prompt") @db.Text
  userPromptTemplate   String   @map("user_prompt_template") @db.Text
  contentHash          String   @map("content_hash")
  provider             String
  model                String
  scriptId             String?  @map("script_id")
  ragMode              String?  @map("rag_mode")
  ragLibraryIds        Json     @default("[]") @map("rag_library_ids")
  sequenceMode         String?  @map("sequence_mode")
  channelMix           String?  @map("channel_mix")
  stepCount            Int?     @map("step_count")
  personalizationDepth String?  @map("personalization_depth")
  parentConfigId       String?  @map("parent_config_id")
  /// draft | lab_passed | canary | active | archived | rejected
  status               String   @default("draft")
  createdBy            String?  @map("created_by")
  notes                String?
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId])
  @@index([organizationId, featureKey, status])
  @@map("outreach_configs")
}

/// Zone pointer: lab | canary | default -> configId.
model OutreachZonePointer {
  organizationId String   @map("organization_id")
  featureKey     String   @map("feature_key")
  /// lab | canary | default
  zone           String
  configId       String   @map("config_id")
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?  @map("updated_by")

  @@id([organizationId, featureKey, zone])
  @@index([organizationId])
  @@map("outreach_zone_pointers")
}

/// One row per LLM generation call with full provenance.
model AiGeneration {
  id               String    @id
  organizationId   String    @map("organization_id")
  configId         String    @map("config_id")
  featureKey       String    @map("feature_key")
  /// lab | canary | default | production
  zone             String
  leadId           String?   @map("lead_id")
  userId           String?   @map("user_id")
  provider         String
  model            String
  systemPromptHash String    @map("system_prompt_hash")
  userPrompt       String    @map("user_prompt") @db.Text
  contextHash      String    @map("context_hash")
  output           Json      @default("{}")
  inputTokens      Int       @default(0) @map("input_tokens")
  outputTokens     Int       @default(0) @map("output_tokens")
  latencyMs        Int       @default(0) @map("latency_ms")
  /// ok | error
  status           String
  errorCode        String?   @map("error_code")
  accepted         Boolean?
  acceptedAt       DateTime? @map("accepted_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId])
  @@index([organizationId, configId, createdAt])
  @@index([organizationId, leadId])
  @@map("ai_generations")
}

/// Bridges client followup id to generation + config for outcome joins.
model SequenceStepProvenance {
  followupId       String   @id @map("followup_id")
  organizationId   String   @map("organization_id")
  planId           String?  @map("plan_id")
  leadId           String?  @map("lead_id")
  generationId     String   @map("generation_id")
  configId         String   @map("config_id")
  zone             String
  experimentId     String?  @map("experiment_id")
  variantId        String?  @map("variant_id")
  stepIndex        Int      @map("step_index")
  channel          String?
  generatedSubject String?  @map("generated_subject")
  generatedBody    String?  @map("generated_body") @db.Text
  sentSubject      String?  @map("sent_subject")
  sentBody         String?  @map("sent_body") @db.Text
  editDistance     Int?     @map("edit_distance")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId])
  @@index([organizationId, configId])
  @@index([organizationId, generationId])
  @@index([organizationId, planId])
  @@map("sequence_step_provenance")
}

model EvalDatasetItem {
  id             String   @id
  organizationId String   @map("organization_id")
  datasetKey     String   @map("dataset_key")
  label          String
  segment        String
  leadContext    Json     @map("lead_context")
  threadContext  Json?    @map("thread_context")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, datasetKey, active])
  @@map("eval_dataset_items")
}

model EvalRun {
  id                 String    @id
  organizationId     String    @map("organization_id")
  configId           String    @map("config_id")
  datasetKey         String    @map("dataset_key")
  /// pending | running | completed | failed
  status             String
  itemCount          Int       @default(0) @map("item_count")
  passCount          Int       @default(0) @map("pass_count")
  failCount          Int       @default(0) @map("fail_count")
  hallucinationCount Int       @default(0) @map("hallucination_count")
  meanJudgeScore     Float?    @map("mean_judge_score")
  comparedToConfigId String?   @map("compared_to_config_id")
  pairwiseWins       Int?      @map("pairwise_wins")
  pairwiseLosses     Int?      @map("pairwise_losses")
  summary            Json      @default("{}")
  startedAt          DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt         DateTime? @map("finished_at") @db.Timestamptz(3)

  @@index([organizationId, configId])
  @@map("eval_runs")
}

model EvalResult {
  id             String   @id
  organizationId String   @map("organization_id")
  evalRunId      String   @map("eval_run_id")
  datasetItemId  String   @map("dataset_item_id")
  generationId   String?  @map("generation_id")
  ruleFailures   Json     @default("[]") @map("rule_failures")
  judgeScores    Json     @default("{}") @map("judge_scores")
  judgeNotes     String?  @map("judge_notes")
  passed         Boolean
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, evalRunId])
  @@map("eval_results")
}

model Experiment {
  id             String    @id
  organizationId String    @map("organization_id")
  name           String
  hypothesis     String    @db.Text
  /// draft | running | stopped | concluded
  status         String    @default("draft")
  primaryMetric  String    @map("primary_metric")
  /// 1 | 2
  stage          Int       @default(1)
  minPerArm      Int       @default(600) @map("min_per_arm")
  startedAt      DateTime? @map("started_at") @db.Timestamptz(3)
  stoppedAt      DateTime? @map("stopped_at") @db.Timestamptz(3)
  stopReason     String?   @map("stop_reason")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, status])
  @@map("experiments")
}

model ExperimentArm {
  id             String  @id
  organizationId String  @map("organization_id")
  experimentId   String  @map("experiment_id")
  label          String
  configId       String  @map("config_id")
  allocation     Int     @default(50)
  isControl      Boolean @default(false) @map("is_control")

  @@index([organizationId, experimentId])
  @@map("experiment_arms")
}

model ExperimentAssignment {
  id             String   @id
  organizationId String   @map("organization_id")
  experimentId   String   @map("experiment_id")
  armId          String   @map("arm_id")
  leadId         String   @map("lead_id")
  assignedAt     DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  @@unique([experimentId, leadId])
  @@index([organizationId, experimentId])
  @@map("experiment_assignments")
}

/// Precomputed scorecard per outreach config (worker-refreshed).
model OutreachConfigScorecard {
  configId             String   @id @map("config_id")
  organizationId       String   @map("organization_id")
  delivered            Int      @default(0)
  sent                 Int      @default(0)
  bounced              Int      @default(0)
  positiveReplies      Int      @default(0) @map("positive_replies")
  engagedReplies       Int      @default(0) @map("engaged_replies")
  hardNoCount          Int      @default(0) @map("hard_no_count")
  unsubscribeCount     Int      @default(0) @map("unsubscribe_count")
  spamComplaintCount   Int      @default(0) @map("spam_complaint_count")
  potentialScoreSum    Float    @default(0) @map("potential_score_sum")
  generationCount      Int      @default(0) @map("generation_count")
  acceptedCount        Int      @default(0) @map("accepted_count")
  editDistanceSum      Float    @default(0) @map("edit_distance_sum")
  editDistanceCount    Int      @default(0) @map("edit_distance_count")
  maturityPct          Float    @default(0) @map("maturity_pct")
  positiveReplyRate    Float    @default(0) @map("positive_reply_rate")
  engagedReplyRate     Float    @default(0) @map("engaged_reply_rate")
  meanPotentialScore   Float    @default(0) @map("mean_potential_score")
  acceptanceRate       Float    @default(0) @map("acceptance_rate")
  meanEditDistance     Float    @default(0) @map("mean_edit_distance")
  bounceRate           Float    @default(0) @map("bounce_rate")
  unsubscribeRate      Float    @default(0) @map("unsubscribe_rate")
  hardNoRate           Float    @default(0) @map("hard_no_rate")
  spamComplaintRate    Float    @default(0) @map("spam_complaint_rate")
  /// Offline eval snapshot
  offlinePassRate      Float?   @map("offline_pass_rate")
  offlineHallucination Float?   @map("offline_hallucination")
  judgeWinRate         Float?   @map("judge_win_rate")
  segments             Json     @default("{}")
  posteriorAlpha       Float    @default(1) @map("posterior_alpha")
  posteriorBeta        Float    @default(1) @map("posterior_beta")
  confoundWarnings     Json     @default("[]") @map("confound_warnings")
  refreshedAt          DateTime @default(now()) @map("refreshed_at") @db.Timestamptz(3)

  @@index([organizationId])
  @@map("outreach_config_scorecards")
}
