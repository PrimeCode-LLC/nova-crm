{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@nova/scoring": ["./packages/nova-scoring/src/index.ts"],
      "@nova/scoring/*": ["./packages/nova-scoring/src/*"],
      "firebase-admin/firestore": ["./src/lib/db/pg-firestore/shim-firestore.ts"],
      "firebase-admin/app": ["./src/lib/db/pg-firestore/shim-app.ts"],
      "firebase-admin/auth": ["./src/lib/db/pg-firestore/shim-auth.ts"],
      "firebase/firestore": ["./src/lib/db/pg-firestore/shim-client-firestore.ts"],
      "firebase/app": ["./src/lib/db/pg-firestore/shim-client-app.ts"],
      "firebase/auth": ["./src/lib/db/pg-firestore/shim-client-auth.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "scripts", "packs/private", "extension", "**/*.emulator.test.ts", "src/app/(auth)/login/login-client.tsx", "src/app/(auth)/signup/signup-client.tsx"]
}
