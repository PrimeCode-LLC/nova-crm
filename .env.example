# Public site origin only — no path (not …/dashboard). Used for invite links.
# SITE_URL is server-only (runtime); NEXT_PUBLIC_SITE_URL is also exposed to the browser.
# NEXT_PUBLIC_SITE_URL=https://app.example.com
# SITE_URL=https://app.example.com
# Optional: absolute origin for first-party email open/click tracking links (cron-safe).
# Falls back to NEXT_PUBLIC_SITE_URL / SITE_URL. Prefer a dedicated subdomain in production.
# MAIL_TRACKING_BASE_URL=https://t.example.com
# Optional: HMAC secret for tracking tokens (falls back to EMAIL_SECRETS_KEY_BASE64).
# MAIL_TRACKING_SECRET=
# Optional: used in app-sent system emails (invites, password reset)
# NEXT_PUBLIC_SITE_NAME=Nova CRM

# Nova Intent Radar extension allowlist (server-only, comma-separated fixed Chrome/Edge IDs).
# Set production store IDs in NOVA_EXTENSION_IDS and unpacked local IDs separately.
# NOVA_EXTENSION_IDS=
# NOVA_EXTENSION_DEV_IDS=

# Transactional email (invitations, owner setup links, password resets). Independent of per-user SMTP.
# Option A — SMTP (nodemailer):
# SYSTEM_SMTP_HOST=smtp.example.com
# SYSTEM_SMTP_PORT=587
# SYSTEM_SMTP_SECURE=false
# SYSTEM_SMTP_USER=
# SYSTEM_SMTP_PASS=
# SYSTEM_SMTP_FROM="Nova CRM <noreply@yourdomain.com>"
#
# Option B — Resend API (no SMTP host needed). Password reset still uses the same sender.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# RESEND_FROM="Nova CRM <onboarding@resend.dev>"
# (Use your verified domain in production instead of onboarding@resend.dev.)

# AI provider API keys at rest (32-byte key, base64). Org keys stored encrypted in Postgres.
# Can reuse the same value as EMAIL_SECRETS_KEY_BASE64 if you already generate one.
# AI_SECRETS_KEY_BASE64=

# Inbound lead webhook (POST /api/integrations/webhook/lead)
# Legacy single-tenant secret. New per-tenant secrets live on the org doc.
# INBOUND_WEBHOOK_SECRET=

# Google Calendar (Scheduling → Availability)
# Server redirect with refresh tokens (recommended):
#   redirect URI: {NEXT_PUBLIC_SITE_URL}/api/scheduling/oauth/google
# Same client can also connect Google Workspace mailboxes (Settings → Email):
#   add redirect URI {NEXT_PUBLIC_SITE_URL}/api/email/oauth/google
#   enable scope https://mail.google.com/ (sensitive — testing users / Workspace approval)
# Optional mail-only overrides: GOOGLE_MAIL_CLIENT_ID / GOOGLE_MAIL_CLIENT_SECRET
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# Or expose the same client id to the browser (GIS) without server secret:
# NEXT_PUBLIC_GOOGLE_CALENDAR_CLIENT_ID=
#
# Microsoft Outlook / 365 (optional, connect UI ready)
# MICROSOFT_CALENDAR_CLIENT_ID=
# MICROSOFT_CALENDAR_CLIENT_SECRET=

# Hourly RSS scraper cron (GET /api/cron/scrapers/run).
# Every 5 minutes: scheduled outbound email cron (GET /api/cron/scheduled-emails/send)
# Cron container / worker calls these routes with:
#   Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=

# Instantly reply webhook fallback (per-tenant secret preferred on org doc: instantlyWebhookSecret)
# INSTANTLY_WEBHOOK_SECRET=

# Skip auth (local UI dev only; do not use in production)
# DISABLE_AUTH=true
# NEXT_PUBLIC_AUTH_DISABLED=true

# Phase 5 Clerk auth (required).
# Get keys from https://dashboard.clerk.com → API Keys (never commit real secrets).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Optional webhook signing secret (user sync)
# CLERK_WEBHOOK_SECRET=whsec_...

# Local Postgres + Redis (docker compose up -d postgres redis) — see docs/ENVIRONMENTS.md
# Never point these at staging/production. Separate DB per environment is mandatory.
# Runtime app role (FORCE RLS enforced). Used by src/lib/db/prisma.ts.
DATABASE_URL=postgres://nova_app:nova_dev_password@localhost:5432/nova_crm
# Migrate/DDL role (Compose superuser). Used by Prisma CLI via prisma.config.ts.
MIGRATE_DATABASE_URL=postgres://nova:nova_dev_password@localhost:5432/nova_crm
# Used by src/lib/cache/redis.ts (dashboard summary cache, default TTL 60s)
# and BullMQ (`src/lib/queue/*`). Same Redis; BullMQ uses its own key prefix.
REDIS_URL=redis://localhost:6379
# Optional Postgres pool size for Prisma adapter (default 10).
# PG_POOL_MAX=10

# BullMQ worker. Defaults on when REDIS_URL is set unless explicitly false.
# QUEUE_WORKER_V1=true
# QUEUE_IMPORT_CHUNKS_V1=true
# QUEUE_HEAVY_JOBS_V1=true

# Platform super-admin bootstrap (comma-separated emails).
# PLATFORM_ADMIN_EMAILS=you@yourcompany.com,cofounder@yourcompany.com
