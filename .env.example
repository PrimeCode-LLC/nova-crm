# Firebase Web SDK (public; safe in client bundles)
# From Firebase Console → Project settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: Firebase Analytics (Web)
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (server only; never prefix with NEXT_PUBLIC_)
# Service account: Firebase Console → Project settings → Service accounts → Generate new private key
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Public site origin only — no path (not …/dashboard). Used for invite links and Firebase reset continueUrl → {origin}/login
# Public site URL (origin only). Required on Firebase App Hosting for OAuth redirects.
# SITE_URL is server-only (runtime); NEXT_PUBLIC_SITE_URL is also exposed to the browser.
# NEXT_PUBLIC_SITE_URL=https://app.example.com
# SITE_URL=https://app.example.com
# Optional: absolute origin for first-party email open/click tracking links (cron-safe).
# Falls back to NEXT_PUBLIC_SITE_URL / SITE_URL. Prefer a dedicated subdomain in production.
# MAIL_TRACKING_BASE_URL=https://t.example.com
# Optional: HMAC secret for tracking tokens (falls back to EMAIL_SECRETS_KEY_BASE64).
# MAIL_TRACKING_SECRET=
# Optional: used in app-sent system emails (invites, password reset)
# NEXT_PUBLIC_SITE_NAME=Nova CRM

# Nova Intent Radar extension allowlist (server-only, comma-separated fixed Chrome/Edge IDs).
# Set production store IDs in NOVA_EXTENSION_IDS and unpacked local IDs separately.
# NOVA_EXTENSION_IDS=
# NOVA_EXTENSION_DEV_IDS=

# Transactional email (invitations, owner setup links, password resets). Independent of per-user SMTP.
# Option A — SMTP (nodemailer):
# SYSTEM_SMTP_HOST=smtp.example.com
# SYSTEM_SMTP_PORT=587
# SYSTEM_SMTP_SECURE=false
# SYSTEM_SMTP_USER=
# SYSTEM_SMTP_PASS=
# SYSTEM_SMTP_FROM="Nova CRM <noreply@yourdomain.com>"
#
# Option B — Resend API (no SMTP host needed). Password reset still uses the same sender.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# RESEND_FROM="Nova CRM <onboarding@resend.dev>"
# (Use your verified domain in production instead of onboarding@resend.dev.)

# AI provider API keys at rest (32-byte key, base64). Org keys stored encrypted in Firestore.
# Can reuse the same value as EMAIL_SECRETS_KEY_BASE64 if you already generate one.
# AI_SECRETS_KEY_BASE64=

# Inbound lead webhook (POST /api/integrations/webhook/lead)
# Legacy single-tenant secret. New per-tenant secrets live on the org doc.
# INBOUND_WEBHOOK_SECRET=

# Google Calendar (Scheduling → Availability → Sign in with Google)
# Default: uses Firebase Google sign-in + calendar scopes — no extra vars if NEXT_PUBLIC_FIREBASE_* is set.
# Enable "Google Calendar API" in Google Cloud Console for your Firebase project (one-time).
# Optional — lets Nova users connect ANY Google calendar (independent of Nova login):
#   Client id only → browser popup (GIS). Add authorized JavaScript origins for your site URL.
#   Client id + secret → server redirect with refresh tokens (recommended for production):
#   redirect URI: {NEXT_PUBLIC_SITE_URL}/api/scheduling/oauth/google
# Same client can also connect Google Workspace mailboxes (Settings → Email):
#   add redirect URI {NEXT_PUBLIC_SITE_URL}/api/email/oauth/google
#   enable scope https://mail.google.com/ (sensitive — testing users / Workspace approval)
# Optional mail-only overrides: GOOGLE_MAIL_CLIENT_ID / GOOGLE_MAIL_CLIENT_SECRET
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# Or expose the same client id to the browser (GIS) without server secret:
# NEXT_PUBLIC_GOOGLE_CALENDAR_CLIENT_ID=
#
# Microsoft Outlook / 365 (optional, connect UI ready)
# MICROSOFT_CALENDAR_CLIENT_ID=
# MICROSOFT_CALENDAR_CLIENT_SECRET=

# Hourly RSS scraper cron (GET /api/cron/scrapers/run). Required on App Hosting + Cloud Functions.
# Every 5 minutes: scheduled outbound email cron (GET /api/cron/scheduled-emails/send)
# Cloud Functions `runDueScrapers` / `sendDueScheduledEmails` call these routes with:
#   Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=

# Instantly reply webhook fallback (per-tenant secret preferred on org doc: instantlyWebhookSecret)
# INSTANTLY_WEBHOOK_SECRET=

# Skip auth (local UI dev only; do not use in production)
# DISABLE_AUTH=true
# NEXT_PUBLIC_AUTH_DISABLED=true

# Phase 5 Clerk auth (P5.0/P5.1). Default off = Firebase Auth only.
# Get keys from https://dashboard.clerk.com → API Keys (never commit real secrets).
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# AUTH_CLERK_V1=true
# NEXT_PUBLIC_AUTH_CLERK_V1=true
# Optional webhook signing secret (user sync — later)
# CLERK_WEBHOOK_SECRET=whsec_...

# Local Postgres + Redis (docker compose up -d postgres redis) — see docs/ENVIRONMENTS.md
# Never point these at staging/production. Separate DB per environment is mandatory.
# Runtime app role (FORCE RLS enforced). Used by src/lib/db/prisma.ts.
DATABASE_URL=postgres://nova_app:nova_dev_password@localhost:5432/nova_crm
# Migrate/DDL role (Compose superuser). Used by Prisma CLI via prisma.config.ts.
MIGRATE_DATABASE_URL=postgres://nova:nova_dev_password@localhost:5432/nova_crm
# Used by src/lib/cache/redis.ts (dashboard summary cache, default TTL 60s)
# and Phase 4 BullMQ (`src/lib/queue/*`). Same Redis; BullMQ uses its own key prefix.
REDIS_URL=redis://localhost:6379
# Optional Postgres pool size for Prisma adapter (default 10).
# PG_POOL_MAX=10

# Phase 4 BullMQ worker (P4.1+). Default off = Cloud Functions / AH cron paths.
# Requires REDIS_URL + a running worker (`npm run worker` / Dockerfile.worker).
# QUEUE_WORKER_V1=true
# QUEUE_IMPORT_CHUNKS_V1=true
# QUEUE_HEAVY_JOBS_V1=true

# Phase 0 dashboard summaries (P0.5). Default off = live client aggregation.
# P3.4: prefer Postgres read flags below; keep these only for Firestore rollback.
# DASHBOARD_SUMMARIES_V1=true
# NEXT_PUBLIC_DASHBOARD_SUMMARIES_V1=true
# Opt-in Firestore orgDashboardSummaries writes (P3.4 rollback; default off).
# DASHBOARD_SUMMARIES_FIRESTORE_WRITER_V1=true

# Phase 2 org/member dual-write (P2.3). Default off = Firestore-only writes.
# When true, successful org/member Firestore writes are mirrored to Postgres.
# POSTGRES_DUAL_WRITE_ORGS_V1=true

# Phase 2 CRM dual-write (P2.6–P2.9): accounts/contacts/leads/deals.
# POSTGRES_DUAL_WRITE_CRM_V1=true

# Phase 2 Postgres leads list read (P2.10). Default off = Firestore onSnapshot.
# When true, workspace leads load via GET /api/org/leads (Postgres + RLS).
# Set both so server APIs and client shells agree.
# POSTGRES_READ_LEADS_V1=true
# NEXT_PUBLIC_POSTGRES_READ_LEADS_V1=true

# Phase 6 Postgres CRM directory/deals read (P6.1). Default off = Firestore onSnapshot.
# When true, workspace accounts/contacts/deals load via GET /api/org/{accounts|contacts|deals}.
# Set both so server APIs and client shells agree. Profiles stay on Firestore.
# POSTGRES_READ_CRM_V1=true
# NEXT_PUBLIC_POSTGRES_READ_CRM_V1=true

# Phase 6 Postgres sole writer for CRM entities (P6.2). Default off = Firestore-first writes.
# When true, client persist helpers write Postgres only via POST /api/org/crm-write (no FS write).
# Enable only after dual-write + reconcile clean AND read flags (leads + CRM) are on.
# Orgs/members are NOT covered yet (still FS writers).
# POSTGRES_SOLE_WRITER_CRM_V1=true
# NEXT_PUBLIC_POSTGRES_SOLE_WRITER_CRM_V1=true

# Phase 3 Postgres dashboard summary writer (P3.2). Default off.
# When true, lead/deal dual-writes schedule a debounced upsert into
# org_dashboard_summaries (~60s coalesce). Cron:
# GET /api/cron/dashboard-summaries/refresh (Bearer CRON_SECRET).
# POSTGRES_DASHBOARD_SUMMARY_WRITER_V1=true

# Phase 3 Postgres dashboard summary read (P3.3/P3.4). Default off.
# When true, GET /api/org/dashboard-summary reads Postgres only (+ Redis).
# Set both so server APIs and client shells agree.
# POSTGRES_DASHBOARD_SUMMARY_READ_V1=true
# NEXT_PUBLIC_POSTGRES_DASHBOARD_SUMMARY_READ_V1=true
# Cloud Functions: ORG_DASHBOARD_SUMMARY_STORE=postgres|firestore|dual (default postgres)

# Platform super-admin bootstrap (comma-separated emails). Operators matching this list can open
# /platform before any Firestore platformAdmins documents exist. Also used alongside platformAdmins.
# PLATFORM_ADMIN_EMAILS=you@yourcompany.com,cofounder@yourcompany.com
